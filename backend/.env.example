# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret
SUPABASE_ANON_KEY=your-anon-public-key

# ── ML ────────────────────────────────────────────────────────────────────────
# Defaults point to the sibling model repo — change only if you move the artifacts
# MODEL_ARTIFACTS_DIR=../habittrace_model_dev-main/artifacts
# ML_CODE_DIR=../habittrace_model_dev-main

# ── CORS / browser origin ─────────────────────────────────────────────────────
# Local dev: leave FRONTEND_URL as below and omit CORS_ORIGINS (localhost is allowed automatically).
# Production: set FRONTEND_URL to your Next.js site origin and set CORS_ORIGINS to the same value
# (comma-separate multiple origins, e.g. https://app.example.com,https://www.example.com).
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=https://app.example.com

# ── Reverse proxy (HTTPS) ─────────────────────────────────────────────────────
# When the API sits behind nginx, Caddy, Railway, Fly, etc., enable so request scheme/client IP are correct.
# TRUST_FORWARDED_HEADERS=true
# Use * only when you fully trust the proxy chain (typical on managed PaaS).
# PROXY_TRUSTED_HOSTS=*

# ── API URL path ──────────────────────────────────────────────────────────────
# If the app is served at https://domain.com/api (not at domain root), set:
# API_ROOT_PATH=/api

# ── Ollama (AI Coach) ─────────────────────────────────────────────────────────
# OLLAMA_CHAT_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=phi3
