# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret
SUPABASE_ANON_KEY=your-anon-public-key

# AI V2 database (backend only; never use NEXT_PUBLIC_ for the service_role key)
AI_SUPABASE_URL=https://YOUR_AI_PROJECT_REF.supabase.co
AI_SUPABASE_SERVICE_ROLE_KEY=your-ai-service-role-secret

# Optional: set these only when bearer tokens come from a different Auth project.
# Otherwise SUPABASE_URL and SUPABASE_ANON_KEY above are used.
# AUTH_SUPABASE_URL=https://YOUR_AUTH_PROJECT_REF.supabase.co
# AUTH_SUPABASE_ANON_KEY=your-auth-project-anon-public-key

# ── ML ────────────────────────────────────────────────────────────────────────
# Defaults point to the sibling model repo — change only if you move the artifacts
# MODEL_ARTIFACTS_DIR=../habittrace_model_dev-main/artifacts
# AI V2 model package/artifacts (development default points to synthetic baseline)
# AI_V2_CODE_DIR=../habittrace_ai_v2
# AI_V2_ARTIFACTS_DIR=../habittrace_ai_v2/artifacts/synthetic
# ML_CODE_DIR=../habittrace_model_dev-main

# ── CORS / browser origin ─────────────────────────────────────────────────────
# Local dev: leave FRONTEND_URL as below and omit CORS_ORIGINS (localhost is allowed automatically).
# Production: set FRONTEND_URL to your Next.js site origin and set CORS_ORIGINS to the same value
# (comma-separate multiple origins, e.g. https://app.example.com,https://www.example.com).
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=https://app.example.com

# ── Reverse proxy (HTTPS) ─────────────────────────────────────────────────────
# When the API sits behind nginx, Caddy, Railway, Fly, etc., enable so request scheme/client IP are correct.
# TRUST_FORWARDED_HEADERS=true
# Use * only when you fully trust the proxy chain (typical on managed PaaS).
# PROXY_TRUSTED_HOSTS=*

# ── API URL path ──────────────────────────────────────────────────────────────
# If the app is served at https://domain.com/api (not at domain root), set:
# API_ROOT_PATH=/api

# -- AI Coach LLM provider -----------------------------------------------------
# Use "ollama" for local Phi-3, or "gemini" for the cloud development provider.
LLM_PROVIDER=ollama

# ── Ollama (AI Coach) ─────────────────────────────────────────────────────────
# OLLAMA_CHAT_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=phi3

# -- Gemini (AI Coach, backend only) ------------------------------------------
# Required only when LLM_PROVIDER=gemini. Do not expose this key to the frontend.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MAX_OUTPUT_TOKENS=1200

# ── Rate limiting (expensive endpoints) ───────────────────────────────────────
# Shared window size in seconds
# RATE_LIMIT_WINDOW_SECONDS=60
# POST /predict requests allowed per key (user ID, fallback client IP)
# PREDICT_REQUESTS_PER_WINDOW=30
# POST /chat requests allowed per key (user ID, fallback client IP)
# CHAT_REQUESTS_PER_WINDOW=10
